# Copy to .env for running on your computer. On Vercel, add the same names under
# Project → Settings → Environment Variables.

# Razorpay → Account & Settings → API Keys (use rzp_test_ keys until you go live)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Any long random text (keeps customers signed in securely). Never share it.
AUTH_SECRET=change-me-to-a-long-random-string

# Your email address(es). Accounts with these emails can open the Owner admin page.
OWNER_EMAILS=you@example.com

# Postgres database. On Vercel, adding a Neon database fills this in for you.
# Leave it out on your computer: a local database is kept in the .data folder.
# DATABASE_URL=postgres://...
