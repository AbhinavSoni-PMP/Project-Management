# Copy to .env for local development. On Vercel, add these under Project → Settings → Environment Variables.
# Get them from https://dashboard.razorpay.com → Account & Settings → API Keys.
# Use the rzp_test_ keys until you're ready to take real money.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
